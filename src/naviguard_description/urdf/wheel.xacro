<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel properties -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_mass" value="1.5"/>

  <!-- Wheel macro -->
  <xacro:macro name="naviguard_wheel" params="prefix x_offset y_offset z_offset:=-0.02">
    <link name="${prefix}_wheel">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
          iyz="0.0"
          izz="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
      </inertial>

      <!-- Collision cylinder -->
      <collision name="${prefix}_wheel_collision">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- Visual tire -->
      <visual name="${prefix}_wheel_tire">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_rubber_black"/>
      </visual>

      <!-- Visual rim / hub -->
      <visual name="${prefix}_wheel_rim">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.6}" length="${wheel_width + 0.002}"/>
        </geometry>
        <material name="wheel_rim_silver"/>
      </visual>
    </link>

    <!-- Revolute / continuous joint connecting wheel to base_link -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <!-- Gazebo physics & friction settings -->
    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>0.3</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <material>
        <ambient>0.1 0.1 0.1 1.0</ambient>
        <diffuse>0.1 0.1 0.1 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </gazebo>
  </xacro:macro>

</robot>
