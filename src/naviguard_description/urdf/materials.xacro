<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- NAVIGUARD SIH 2026 Color Palette -->
  <material name="chassis_grey">
    <color rgba="0.2 0.22 0.25 1.0"/>
  </material>

  <material name="naviguard_orange">
    <color rgba="0.95 0.36 0.05 1.0"/>
  </material>

  <material name="wheel_rubber_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="wheel_rim_silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <material name="sensor_mast_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="camera_blue">
    <color rgba="0.05 0.25 0.65 1.0"/>
  </material>

  <material name="lens_glass">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="imu_gold">
    <color rgba="0.85 0.75 0.2 1.0"/>
  </material>
</robot>
