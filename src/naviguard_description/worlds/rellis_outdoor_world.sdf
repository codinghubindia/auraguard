    <!-- ==================================================================== -->
    <!-- DEDICATED NARROW GATEWAY PASSAGE (x = 8.5m)                           -->
    <!-- Gateway formed by Twin Oak Trees / Rock Formations:                  -->
    <!--  Left Tree:  Center (8.5, +0.57), trunk radius 0.24m -> Edge @ +0.33m -->
    <!--  Right Tree: Center (8.5, -0.57), trunk radius 0.24m -> Edge @ -0.33m -->
    <!--  Available passage width = 0.33 - (-0.33) = 0.66m                    -->
    <!--  UGV Width = 0.48m -> Symmetrical clearance = 0.09m (9 cm) on both sides -->
    <!--  Tight limit is 0.58m -> Passage is WIDE ENOUGH to navigate through! -->
    <!-- ==================================================================== -->

    <!-- Gateway Tree Left (Texas Post Oak - Passage Boundary) -->
    <model name="gateway_tree_left">
      <static>true</static>
      <pose>8.5 0.57 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual_trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.34 0.21 0.12 1.0</ambient>
            <diffuse>0.39 0.25 0.15 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
          </material>
        </visual>
        <!-- Layer 1 Lower Foliage -->
        <visual name="canopy_lower">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.4</radius>
            </geometry>
          </material>
            <ambient>0.16 0.38 0.13 1.0</ambient>
            <diffuse>0.21 0.48 0.17 1.0</diffuse>
          </material>
        </visual>
        <!-- Layer 2 Crown Foliage -->
        <visual name="canopy_crown">
          <pose>0 0 4.0 0 0 0.3</pose>
          <geometry>
            <sphere>
              <radius>1.1</radius>
            </geometry>
          </material>
            <ambient>0.19 0.44 0.15 1.0</ambient>
            <diffuse>0.25 0.54 0.20 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gateway Tree Right (Texas Post Oak - Passage Boundary) -->
    <model name="gateway_tree_right">
      <static>true</static>
      <pose>8.5 -0.57 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 1.5 0 0 0</pose>
