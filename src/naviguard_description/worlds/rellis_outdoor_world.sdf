    <!-- Granite Rock Cairn 1 (Visual Odometry & Map Feature Anchor) -->
    <model name="granite_cairn_1">
      <static>true</static>
      <pose>2.0 -2.4 0.40 0 0 0.45</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.9 0.8 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9 0.8 0.8</size>
            </box>
          </geometry>
          <material>
