    <!-- Wheel Track Rut 1 (Compacted dirt wheel track) -->
    <model name="trail_rut_left">
      <static>true</static>
      <pose>3.0 0.45 0.0025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 0.30 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.44 0.32 0.22 1.0</ambient>
