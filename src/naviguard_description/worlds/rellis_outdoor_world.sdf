    <!-- ==================== NATURAL TERRAIN CHALLENGES ==================== -->
    <!-- RELLIS Mud Patch / Slip Hazard Feature -->
    <model name="rellis_mud_hazard">
      <static>true</static>
      <pose>5.2 0.35 0.004 0 0 0.15</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 1.4 0.004</size>
            </box>
          </geometry>
          <material>
