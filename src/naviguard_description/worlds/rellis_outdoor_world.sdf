    <!-- Trail Segment 3: Winding North-East bend (x: 12 to 20m) -->
    <model name="dirt_trail_segment3">
      <static>true</static>
      <pose>15.5 2.2 0.002 0 0 0.42</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
