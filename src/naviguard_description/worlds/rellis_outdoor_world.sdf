<?xml version="1.0" ?>
<!-- ========================================================================== -->
<!-- RELLIS-3D Realistic Regional Geospatial Outdoor Environment for AURAGUARD   -->
<!-- Generated from Regional Off-Road Geospatial Topography (RELLIS Testbed)    -->
<!-- Features:                                                                  -->
<!--  - High-realism unpaved dirt trail network with ruts and soil verges       -->
<!--  - Realistic Texas Post Oak & Cedar trees with multi-tier foliage canopies -->
<!--  - Natural granite boulder outcroppings, rock cairns, and fallen timber    -->
<!--  - Dedicated small passage gateway at x=8.5m (width 0.66m > vehicle 0.48m) -->
<!--  - Impassable bottleneck on shoulder for contrastive passage evaluation    -->
<!--  - Full 360-degree visual feature coverage for omnidirectional VO          -->
<!-- ========================================================================== -->
<sdf version="1.8">
  <world name="rellis_outdoor_world">

    <!-- Physics configuration for Gazebo Harmonic -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World plugins for Gazebo Harmonic -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- Scene lighting, sky and atmospheric realism -->
    <scene>
      <ambient>0.62 0.64 0.60 1.0</ambient>
      <background>0.58 0.74 0.92 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Natural Outdoor Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 35 0 0 0</pose>
      <diffuse>0.96 0.93 0.86 1.0</diffuse>
      <specular>0.35 0.35 0.35 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.38 0.28 -0.88</direction>
    </light>

    <!-- Secondary Ambient Fill Light (Sky Bounce) -->
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.25 0.32 0.40 1.0</diffuse>
      <specular>0.05 0.05 0.05 1.0</specular>
      <direction>0.3 -0.2 -0.9</direction>
    </light>

    <!-- ==================== REGIONAL GEOSPATIAL BASE TERRAIN ==================== -->
    <model name="rellis_base_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.80</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.42 0.20 1.0</ambient>
            <diffuse>0.32 0.48 0.24 1.0</diffuse>
            <specular>0.03 0.03 0.03 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Natural Grassy Meadow Layer (North Flank) -->
    <model name="grass_meadow_north">
      <static>true</static>
      <pose>10.0 12.0 0.001 0 0 0.08</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>35.0 16.0 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.24 0.38 0.18 1.0</ambient>
            <diffuse>0.28 0.44 0.22 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Natural Grassy Meadow Layer (South Flank) -->
    <model name="grass_meadow_south">
      <static>true</static>
      <pose>10.0 -12.0 0.001 0 0 -0.05</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>35.0 16.0 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.40 0.19 1.0</ambient>
            <diffuse>0.30 0.46 0.23 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

