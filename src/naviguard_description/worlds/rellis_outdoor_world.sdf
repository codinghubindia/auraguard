    <!-- Side Rock Boulder (Creates an Impassable 0.36m Gap with Left Tree for Contrast) -->
    <!-- Left Tree Edge at y = 0.57 + 0.24 = 0.81m. Boulder center at (8.5, 1.35), radius 0.18m -> Edge at 1.17m. -->
    <!-- Gap = 1.17 - 0.81 = 0.36m < 0.48m vehicle width -> PROVEN IMPASSABLE -->
    <model name="side_boulder_impassable_gap">
      <static>true</static>
      <pose>8.5 1.35 0.35 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.7</length>
            </cylinder>
