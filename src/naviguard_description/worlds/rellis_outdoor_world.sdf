<?xml version="1.0" ?>
<!-- RELLIS-3D Realistic Outdoor Unstructured Environment for NAVIGUARD UGV -->
<sdf version="1.8">
  <world name="rellis_outdoor_world">

    <!-- Physics configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World plugins for Gazebo Harmonic -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- Scene lighting and sky -->
    <scene>
      <ambient>0.65 0.65 0.60 1.0</ambient>
      <background>0.60 0.75 0.90 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Outdoor Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <!-- Base Outdoor Terrain (Grass / Soil Surface) -->
    <model name="rellis_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.80</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.45 0.22 1.0</ambient>
            <diffuse>0.35 0.50 0.25 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Main Off-Road Dirt Trail Segment 1 -->
    <model name="dirt_trail_segment1">
      <static>true</static>
      <pose>5.0 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>12.0 3.2 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.40 0.28 1.0</ambient>
            <diffuse>0.58 0.44 0.30 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Main Off-Road Dirt Trail Segment 2 (Curving north-east) -->
    <model name="dirt_trail_segment2">
      <static>true</static>
      <pose>14.0 3.5 0.002 0 0 0.52</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 3.2 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.38 0.26 1.0</ambient>
            <diffuse>0.56 0.42 0.28 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- RELLIS Tree 1 (Left shoulder) -->
    <model name="rellis_tree_1">
      <static>true</static>
      <pose>3.0 2.8 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual_trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.12 1.0</ambient>
            <diffuse>0.40 0.26 0.15 1.0</diffuse>
          </material>
        </visual>
        <visual name="visual_foliage">
          <pose>0 0 3.8 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.4</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.15 0.38 0.12 1.0</ambient>
            <diffuse>0.20 0.48 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- RELLIS Tree 2 (Right shoulder) -->
    <model name="rellis_tree_2">
      <static>true</static>
      <pose>5.5 -2.7 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual_trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.33 0.20 0.10 1.0</ambient>
            <diffuse>0.38 0.24 0.13 1.0</diffuse>
          </material>
        </visual>
        <visual name="visual_foliage">
          <pose>0 0 3.9 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.6</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.14 1.0</ambient>
            <diffuse>0.22 0.52 0.18 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- RELLIS Tree 3 (Trail bend obstacle) -->
    <model name="rellis_tree_3">
      <static>true</static>
      <pose>10.5 1.5 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual_trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.30 0.18 0.10 1.0</ambient>
            <diffuse>0.36 0.22 0.12 1.0</diffuse>
          </material>
        </visual>
        <visual name="visual_foliage">
          <pose>0 0 3.6 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.5</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.16 0.39 0.13 1.0</ambient>
            <diffuse>0.21 0.49 0.16 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fallen Off-Road Log Barrier (Natural Obstacle) -->
    <model name="fallen_log_barrier">
      <static>true</static>
      <pose>8.0 -0.8 0.18 0 1.5708 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>2.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>2.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.28 0.18 0.10 1.0</ambient>
            <diffuse>0.35 0.22 0.14 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mud / Puddle Terrain Feature (Low texture depression zone) -->
    <model name="rellis_mud_patch">
      <static>true</static>
      <pose>6.0 0.5 0.004 0 0 0.2</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 1.8 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.22 0.16 0.11 1.0</ambient>
            <diffuse>0.28 0.20 0.14 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rock Landmark / Cairn (Visual feature anchor) -->
    <model name="rock_cairn_1">
      <static>true</static>
      <pose>2.0 -2.2 0.35 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.48 1.0</ambient>
            <diffuse>0.55 0.55 0.58 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- RELLIS Post Barrier (Trail border marker) -->
    <model name="post_barrier_1">
      <static>true</static>
      <pose>7.5 2.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.55 0.2 1.0</ambient>
            <diffuse>0.7 0.65 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
