    <!-- Wheel Track Rut 2 (Compacted dirt wheel track) -->
    <model name="trail_rut_right">
      <static>true</static>
      <pose>3.0 -0.45 0.0025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
