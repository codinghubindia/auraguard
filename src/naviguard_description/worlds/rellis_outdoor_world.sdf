            <diffuse>0.48 0.36 0.25 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trail Segment 2: Approach and pass-through gateway (x: 6 to 12m) -->
    <model name="dirt_trail_segment2">
      <static>true</static>
      <pose>9.0 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 2.8 0.003</size>
