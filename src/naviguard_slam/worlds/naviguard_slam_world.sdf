<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="naviguard_slam_world">

    <!-- Physics configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World plugins for Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Scene lighting and sky -->
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.87</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.48 0.48 0.45 1.0</ambient>
            <diffuse>0.58 0.58 0.52 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Structure 1: Start/Loop Anchor (Orange Post at 1.5, 0.5) -->
    <model name="anchor_post">
      <static>true</static>
      <pose>1.5 0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.3 0.0 1.0</ambient>
            <diffuse>0.95 0.35 0.05 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Structure 2: East Corner Crate (Blue Crate at 3.5, -0.5) -->
    <model name="east_crate">
      <static>true</static>
      <pose>3.5 -0.5 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.8 1.0</ambient>
            <diffuse>0.15 0.4 0.9 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Structure 3: North-East Post (Green Post at 4.0, 3.0) -->
    <model name="ne_post">
      <static>true</static>
      <pose>4.0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1.0</ambient>
            <diffuse>0.15 0.85 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Structure 4: North Wall/Obstacle (Textured Red Wall at 2.0, 4.0) -->
    <model name="north_wall">
      <static>true</static>
      <pose>2.0 4.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.6 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.6 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.85 0.15 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Structure 5: West Return Marker (Yellow Pillar at -0.5, 2.5) -->
    <model name="west_pillar">
      <static>true</static>
      <pose>-0.5 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.85 0.1 1.0</ambient>
            <diffuse>0.9 0.9 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
